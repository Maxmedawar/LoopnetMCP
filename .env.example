# Loopnet MCP Server Configuration
# All settings are optional — defaults are sensible for normal use.

# Local execution remains stdio by default. Set HTTP only on a hosted server.
# CRE_TRANSPORT=stdio
# CRE_HTTP_HOST=0.0.0.0
# CRE_HTTP_PORT=8000

# Container browser path; Docker sets this to /usr/bin/chromium.
# CRE_BROWSER_PATH=

# Optional pay-per-GB residential proxy for scraper sources. OFF unless set.
# Keep credentials server-side and confirm the provider permits your use case.
# CRE_PROXY_URL=

# LOOPNET_REQUEST_DELAY_SECONDS=2.0
# LOOPNET_MAX_CONCURRENT_REQUESTS=2
# LOOPNET_TIMEOUT_SECONDS=30.0
# LOOPNET_MAX_RETRIES=3
# LOOPNET_CACHE_TTL_SECONDS=300
# LOOPNET_CACHE_MAX_ENTRIES=500

# Optional nationwide parcel/comps fallbacks. Both are pay-per-use and OFF unless
# you explicitly set a key; free county sources are always tried first.
# ATTOM signup/docs: https://api.developer.attomdata.com/
# CRE_ATTOM_API_KEY=
# Regrid signup/docs: https://regrid.com/api
# CRE_REGRID_API_KEY=

# Provider entitlement sync. Stripe ingress remains disabled until a real
# signing secret is configured. Skool ingress must remain unset because the
# official provider does not guarantee immediate restrictive churn delivery.
# CRE_STRIPE_WEBHOOK_SECRET=replace-with-stripe-signing-secret
# CRE_SKOOL_WEBHOOK_SECRET=

# Signed provider request body limit: 1 through 65,536 bytes.
# CRE_PROVIDER_WEBHOOK_MAX_BODY_BYTES=65536
# Fallback lease when a trusted provider period is absent: 1 through 604,800 seconds.
# CRE_PROVIDER_GRANT_LEASE_SECONDS=86400

# JSON maps from provider identifiers to local plan/profile authority.
# CRE_STRIPE_PRICE_MAPPINGS={"price_example":{"plan_key":"local","profile":"local_scout"}}
# CRE_SKOOL_TIER_MAPPINGS={"community_example:level_example":{"plan_key":"local","profile":"local_scout"}}
