# Loopnet MCP Server Configuration
# All settings are optional — defaults are sensible for normal use.

# LOCAL/REFERENCE CONFIGURATION ONLY. Hosted HTTP is launch-blocked until the
# PostgreSQL domain bundle, admission, jobs, privacy, recovery, and private
# staging phases are certified. This is not a production deployment template.
# See docs/launch/PROGRAM_STATUS.md and deploy/DEPLOY.md. Do not provision DNS,
# billing, paid services, or public infrastructure from this file.

# Local execution remains stdio by default. Set HTTP only on a hosted server.
# CRE_TRANSPORT=stdio
# CRE_HTTP_HOST=0.0.0.0
# CRE_HTTP_PORT=8000

# Customer sign-in and OAuth connection. OFF by default. The Clerk secret stays
# server-side; only the publishable key is supplied to web/connection at build time.
# CRE_HUMAN_IDENTITY_PROVIDER=clerk
# CRE_CLERK_SECRET_KEY=
# CRE_CLERK_PUBLISHABLE_KEY=
# CRE_CLERK_AUTHORIZED_PARTIES=["https://connect.example.com"]
# CRE_CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
# CRE_OAUTH_ISSUER=https://mcp.example.com
# CRE_OAUTH_RESOURCE=https://mcp.example.com/mcp
# CRE_CONNECTION_URL=https://connect.example.com/connect
# Server-approved public OAuth clients and their exact callback URIs. Dynamic
# registration fails closed when this map is empty. Names shown at consent are
# taken from this server-owned map, never from public registration input.
# CRE_OAUTH_CLIENT_REGISTRATIONS={"Claude":["https://claude.ai/api/mcp/auth_callback"]}
# Local per-process abuse controls complement mandatory ingress rate limits.
# CRE_OAUTH_REGISTRATION_RATE_LIMIT_PER_MINUTE=30
# CRE_OAUTH_AUTHORIZATION_RATE_LIMIT_PER_MINUTE=30
# CRE_OAUTH_TOKEN_RATE_LIMIT_PER_MINUTE=60
# CRE_OAUTH_PENDING_AUTHORIZATIONS_PER_CLIENT=1024
# CRE_OAUTH_PENDING_AUTHORIZATIONS_GLOBAL=4096
# CRE_BROWSER_SESSION_RATE_LIMIT_PER_MINUTE=10
# CRE_BROWSER_SESSIONS_GLOBAL=10000
# CRE_BROWSER_SESSION_TTL_SECONDS=1800
# CRE_BROWSER_COOKIE_SECURE=true
# Cross-host connection flows use SameSite=None under exact Origin, Host, and
# CSRF checks, so secure cookies are mandatory outside same-host development.

# Internal Operations Console BFF. Leave unset to disable every console route.
# Private network or Access policy is an extra layer; live internal role checks
# still authorize every request.
# CRE_OPERATIONS_CONSOLE_ORIGIN=https://operations.internal.example.com
# CRE_OPERATIONS_SESSION_TTL_SECONDS=1800
# CRE_OPERATIONS_COOKIE_NAME=mcr_ops

# Container browser path; Docker sets this to /usr/bin/chromium.
# CRE_BROWSER_PATH=

# Optional pay-per-GB residential proxy for scraper sources. OFF unless set.
# Keep credentials server-side and confirm the provider permits your use case.
# CRE_PROXY_URL=

# LOOPNET_REQUEST_DELAY_SECONDS=2.0
# LOOPNET_MAX_CONCURRENT_REQUESTS=2
# LOOPNET_TIMEOUT_SECONDS=30.0
# LOOPNET_MAX_RETRIES=3
# LOOPNET_CACHE_TTL_SECONDS=300
# LOOPNET_CACHE_MAX_ENTRIES=500

# Optional nationwide parcel/comps fallbacks. Both are pay-per-use and OFF unless
# you explicitly set a key; free county sources are always tried first.
# ATTOM signup/docs: https://api.developer.attomdata.com/
# CRE_ATTOM_API_KEY=
# Regrid signup/docs: https://regrid.com/api
# CRE_REGRID_API_KEY=

# Provider entitlement sync. Stripe remains OFF until test credentials are
# supplied. During signing-secret rotation, configure every concurrently active
# test endpoint secret. The optional API key is GET-only in this runtime and
# rejects live-mode keys. No Checkout, product, price, charge, or write API is used.
# CRE_STRIPE_WEBHOOK_SECRET=
# CRE_STRIPE_WEBHOOK_SECRETS=["whsec_current","whsec_rotating"]
# CRE_STRIPE_API_KEY=rk_test_restricted_read_only
# CRE_STRIPE_API_VERSION=2026-02-25.clover
# Skool remains OFF unless an operator configures an external signed relay.
# Rotation accepts each listed relay secret. Joining is an audited Admin Invite
# or Zapier Invite task; this runtime never scrapes Skool or calls an undocumented
# member endpoint. Community URLs are operator navigation only.
# CRE_SKOOL_WEBHOOK_SECRET=
# CRE_SKOOL_WEBHOOK_SECRETS=["relay_current","relay_rotating"]
# CRE_SKOOL_RECONCILIATION_MAX_AGE_SECONDS=86400
# CRE_SKOOL_COMMUNITY_URLS={"community_example":"https://www.skool.com/example"}

# Signed provider request body limit: 1 through 65,536 bytes.
# CRE_PROVIDER_WEBHOOK_MAX_BODY_BYTES=65536
# Fallback lease when a trusted provider period is absent: 1 through 604,800 seconds.
# CRE_PROVIDER_GRANT_LEASE_SECONDS=86400

# JSON maps from provider identifiers to local plan/profile authority.
# CRE_STRIPE_PRICE_MAPPINGS={"price_example":{"plan_key":"local","profile":"local_scout"}}
# CRE_SKOOL_TIER_MAPPINGS={"community_example:level_example":{"plan_key":"local","profile":"local_scout"}}
